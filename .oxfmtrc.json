{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "semi": false,
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortPackageJson": false,
  "ignorePatterns": [
    "vendor/**",
    "**/apm_modules/**",
    "**/.apm-local/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.claude-plugin/**",
    "**/.github/hooks/**",
    "**/.github/instructions/**",
    "**/.github/agents/**",
    "**/.github/prompts/**",
    "**/.github/plugin/**",
    "**/.github/copilot-instructions.md",
    "**/apm.lock.yaml",
    "**/.apm/hooks/*.cjs",
    "packages/caveman/.apm/**",
    "packages/fallow/.apm/**",
    "packages/impeccable/**/.apm/**",
    "packages/impeccable/**/apm.yml",
    "packages/impeccable/**/NOTICE.md",
    "packages/playwright-cli/.apm/**",
    "packages/rtk/.apm/**"
  ]
}
