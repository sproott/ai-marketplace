{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk/rtk-hook-wrapper.sh\" hook auto"
          }
        ]
      },
      {
        "matcher": "Bash|bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk/rtk-rewrite-extra.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|bash|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk/rtk-shim-gate.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Installing rtk PATH shim...",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk/rtk-shim-install.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
