{
  "PostToolUse": [
    {
      "matcher": "Edit|Write|apply_patch|str_replace_editor|edit|create|write",
      "hooks": [
        {
          "type": "command",
          "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/personal/comment_style_check.py\"'",
          "timeout": 10
        }
      ],
      "_apm_source": "_local/personal"
    }
  ]
}
