{
  "PreToolUse": [
    {
      "matcher": "Write|apply_patch|str_replace_editor|create|write",
      "hooks": [
        {
          "type": "command",
          "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rules-on-create/rules_on_create.py\"'",
          "timeout": 10
        }
      ],
      "_apm_source": "_local/rules-on-create"
    }
  ]
}
