{
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.fs)",
            "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 .github/hooks/scripts/fsharp/fsharplint_check.py --scoped'",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Edit(*.fsx)",
            "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 .github/hooks/scripts/fsharp/fsharplint_check.py --scoped'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.fs)",
            "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 .github/hooks/scripts/fsharp/fsharplint_check.py --scoped'",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Write(*.fsx)",
            "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 .github/hooks/scripts/fsharp/fsharplint_check.py --scoped'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "apply_patch|str_replace_editor|edit|create|write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && exec python3 .github/hooks/scripts/fsharp/fsharplint_check.py'",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "version": 1
}
