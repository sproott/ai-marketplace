{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Preparing build session",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/impeccable-claude/skills/impeccable/scripts/impeccable\" hook claude SessionStart",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Preparing build session",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/impeccable-claude/skills/impeccable/scripts/impeccable\" hook claude SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking UI changes",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/impeccable-claude/skills/impeccable/scripts/impeccable\" hook claude PostToolUse",
            "timeout": 5
          }
        ]
